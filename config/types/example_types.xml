<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE NmLoader SYSTEM "standardX26.dtd">
<!--
  LAB PLACEHOLDER for a soft-type load file. Only the fake Windchill loads it.

  Do NOT hand-write real type definitions. Export them from your source
  system instead (Site > Utilities > Type and Attribute Management, or the
  export-definition procedure in the acme.windchill.types README): the export
  is a complete LoadFromFile document with the exact elements and handlers
  your Windchill version expects. Save it here and list it in
  inventory/group_vars/windchill/types.yml.

  The element names below are illustrative; the handler class
  (com.ptc.core.lwc.server.TypeDefinitionLoader) is the real one.
-->
<NmLoader>
  <csvBeginTypeDefinition handler="com.ptc.core.lwc.server.TypeDefinitionLoader.beginProcessTypeDefinition">
    <csvname>com.acme.LabPart</csvname>
    <csvparent>WCTYPE|wt.part.WTPart</csvparent>
    <csvdisplayName>Lab Part</csvdisplayName>
  </csvBeginTypeDefinition>
  <csvEndTypeDefinition handler="com.ptc.core.lwc.server.TypeDefinitionLoader.endProcessTypeDefinition">
    <csvname>com.acme.LabPart</csvname>
  </csvEndTypeDefinition>
</NmLoader>
