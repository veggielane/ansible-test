---
# Settings for ansible-lint (run: ansible-lint). "production" is the strictest
# built-in profile; it enforces the conventions the tutorial teaches
# (fully-qualified module names, named tasks, changed_when on commands, ...).
profile: production

exclude_paths:
  - .git/
  - docker/
  - config/
  - lab/
  - build/

skip_list:
  # The collection's shared variables use the plain "windchill_" namespace
  # (windchill_home, windchill_load_*) rather than a per-role prefix; see the
  # same setting in ansible-collection-windchill/.ansible-lint.
  - var-naming[no-role-prefix]
